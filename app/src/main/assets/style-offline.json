{
  "version": 8,
  "name": "Pigeon Offline",
  "metadata": {
    "mapbox:autocomposite": false,
    "mapbox:type": "template"
  },
  "sources": {
    "lebanon": {
      "type": "vector",
      "url": "mbtiles://lebanon_base.mbtiles"
    }
  },
  "glyphs": "asset://fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f7f6"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "lebanon",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0c3d1"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "lebanon",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#f0ede5"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "lebanon",
      "source-layer": "transportation",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e5e2dc",
        "line-width": {
          "base": 1.2,
          "stops": [
            [
              8,
              0.5
            ],
            [
              12,
              1
            ],
            [
              16,
              2
            ]
          ]
        }
      }
    },
    {
      "id": "place_labels",
      "type": "symbol",
      "source": "lebanon",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 14
      },
      "paint": {
        "text-color": "#000000",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road_labels",
      "type": "symbol",
      "source": "lebanon",
      "source-layer": "transportation_name",
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#000000",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ],
  "id": "pigeon-offline-v1"
}